# Migood Updates replaces Ubuntu's Software Updater. The packages stay
# installed (the desktop depends on them), but their menu entry and the
# "updates available" popup are never put on disk.
path-exclude=/usr/share/applications/update-manager.desktop
path-exclude=/etc/xdg/autostart/update-notifier.desktop
# Calamares' generic "Install System" menu entry ("Install Migood OS" is ours).
path-exclude=/usr/share/applications/calamares.desktop
# Ubuntu's "Welcome to Ubuntu" first-login wizard (Migood setup replaces it).
path-exclude=/etc/xdg/autostart/gnome-initial-setup-first-login.desktop
path-exclude=/etc/xdg/autostart/gnome-initial-setup-copy-worker.desktop
