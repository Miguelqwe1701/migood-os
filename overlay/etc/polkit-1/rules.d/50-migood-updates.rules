// Lets the person sitting at the computer press "Check for updates" in
// Migood Updates without a password. Only this one service, only "start",
// only for the local active session. Installing still happens at shutdown.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "migood-os-update.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
