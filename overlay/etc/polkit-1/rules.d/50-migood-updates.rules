// Lets the person sitting at the computer press "Check for updates",
// "Get from GitHub", or "Install now" in Migood Updates without a password.
// Only these update services, only "start", only for the local active session.
polkit.addRule(function (action, subject) {
    var unit = action.lookup("unit");
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (unit == "migood-os-update.service" ||
         unit == "migood-os-update-github.service" ||
         unit == "migood-os-apply-now.service") &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
