#!/usr/bin/env python3
"""Switch between Migood Home and Desktop mode (logs out, then logs back in
into the other one; automatic login and the login screen both follow it).

  migood-switch home      from the desktop to Migood Home
  migood-switch desktop   from Migood Home to the desktop
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import homecore  # noqa: E402

if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "home":
        homecore.home_mode()
    elif mode == "desktop":
        homecore.desktop_mode()
    else:
        sys.exit(__doc__)
