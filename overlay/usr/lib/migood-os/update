#!/usr/bin/env python3
"""Migood OS updater.

How updates flow (see docs/PLAN.md, "Step 3"):

  update check    asks the server for every release newer than ours (oldest
                  first), downloads each file (resuming half-done downloads)
                  and checks its sha256. Verified files wait in the "staged"
                  folder. A systemd timer runs this daily.
  update apply    installs staged releases in order: Timeshift snapshot first,
                  then each bundle (.debs + apply.sh), then bumps VERSION in
                  os-release. Runs at shutdown.
  update checkin  tells the server "this device runs version X".

A bundle is a .tar.gz with an optional debs/ folder and an optional apply.sh.
.iso files in a release are for fresh installs, so the updater skips them.

Only the Python standard library is used, so nothing extra has to be installed.
"""
import hashlib
import json
import os
import pwd
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

# Every path can be changed with an environment variable. The tests use that
# to run the updater inside a temporary folder instead of the real system.
CONF = os.environ.get("MIGOOD_CONF", "/etc/migood-os/update.conf")
STATE = os.environ.get("MIGOOD_STATE", "/var/lib/migood-os")
OS_RELEASE = os.environ.get("MIGOOD_OS_RELEASE", "/usr/lib/os-release")
NO_SNAPSHOT = os.environ.get("MIGOOD_NO_SNAPSHOT") == "1"
# Readable by everyone: the Migood Updates app shows this to the user.
STATUS = os.environ.get("MIGOOD_STATUS", "/var/cache/migood-os/status.json")
DEFAULT_GITHUB_RELEASES = "https://api.github.com/repos/Miguelqwe1701/migood-os/releases"
GITHUB_NOTICE = (
    "Fetched from GitHub Releases: gets the latest release/pre-release directly "
    "from GitHub no matter the channel or rollout (that is how GitHub works)."
)


def log(msg):
    print(f"migood-os-update: {msg}", flush=True)


# ---------- small helpers ----------

def read_kv(path):
    """Read a KEY=value file (update.conf, os-release) into a dict."""
    out = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    return out


def version_key(v):
    """'0.10.2' -> (0, 10, 2), so 0.10 sorts after 0.9 (plain text would not)."""
    return tuple(int(p) if p.isdigit() else 0 for p in v.split("."))


def current_version():
    return read_kv(OS_RELEASE).get("VERSION_ID", "0.0.0")


def set_version(version):
    """Swap VERSION / VERSION_ID in os-release, keep every other line."""
    with open(OS_RELEASE) as f:
        lines = f.read().splitlines()
    out = []
    for line in lines:
        if line.startswith("VERSION_ID="):
            line = f'VERSION_ID="{version}"'
        elif line.startswith("VERSION="):
            line = f'VERSION="{version}"'
        out.append(line)
    tmp = OS_RELEASE + ".new"
    with open(tmp, "w") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, OS_RELEASE)  # all-or-nothing, never a half-written file


def config():
    """SERVERS in update.conf is a space-separated list, tried in order."""
    c = read_kv(CONF)
    servers = [s.rstrip("/") for s in c.get("SERVERS", c.get("SERVER", "")).split()]
    if not servers or not all(s.startswith(("https://", "http://")) for s in servers):
        sys.exit(f"migood-os-update: set SERVERS=https://... in {CONF}")
    return servers, c.get("CHANNEL", "stable")


def github_releases_url(force=False):
    url = (os.environ.get("MIGOOD_GITHUB_RELEASES") or read_kv(CONF).get("GITHUB_RELEASES", "")).strip()
    if not url and force:
        return DEFAULT_GITHUB_RELEASES
    return url


def token():
    """The Migood account token saved at first boot or in the user's ~/.config/migood/token."""
    sys_tok = os.path.join(STATE, "token")
    try:
        with open(sys_tok) as f:
            val = f.read().strip()
            if val:
                return val
    except OSError:
        pass

    # Check the Migood user's ~/.config/migood/token (the same way migood-ai & migood-settings do)
    candidates = []
    try:
        with open(os.path.join(STATE, "account.json")) as f:
            local_user = json.load(f).get("local")
        if local_user:
            candidates.append(os.path.join(pwd.getpwnam(local_user).pw_dir, ".config/migood/token"))
    except (OSError, ValueError, KeyError):
        pass
    if STATE == "/var/lib/migood-os":
        for p in pwd.getpwall():
            if p.pw_uid == 1000:
                candidates.append(os.path.join(p.pw_dir, ".config/migood/token"))
        candidates.append(os.path.expanduser("~/.config/migood/token"))

    for path in candidates:
        try:
            with open(path) as f:
                val = f.read().strip()
            if val:
                try:
                    os.makedirs(STATE, exist_ok=True)
                    with open(sys_tok, "w") as out:
                        out.write(val + "\n")
                    os.chmod(sys_tok, 0o600)
                except OSError:
                    pass
                return val
        except OSError:
            pass
    sys.exit("migood-os-update: not signed in yet (no token)")


def device_id():
    """A random id for this computer, made once and then kept."""
    path = os.path.join(STATE, "device-id")
    try:
        with open(path) as f:
            return f.read().strip()
    except FileNotFoundError:
        os.makedirs(STATE, exist_ok=True)
        dev = str(uuid.uuid4())
        with open(path, "w") as f:
            f.write(dev + "\n")
        return dev


# Answers that mean "something in the way" (e.g. Cloudflare's bot check),
# not "the Migood server said no". A 404 is a real answer (not in the Beta),
# so it does NOT move on to the next server.
BLOCKED = {403, 429, 502, 503, 504, 520, 521, 522, 523, 524, 525, 526}


def request(servers, path, data=None, headers=None):
    h = {"Authorization": f"Bearer {token()}", "User-Agent": "migood-os-update"}
    h.update(headers or {})
    body = None
    if data is not None:
        body = json.dumps(data).encode()
        h["Content-Type"] = "application/json"
    last = None
    for server in servers:
        req = urllib.request.Request(server + path, data=body, headers=h)
        try:
            return urllib.request.urlopen(req, timeout=60)
        except urllib.error.HTTPError as e:
            if e.code not in BLOCKED:
                raise
            last = e
        except urllib.error.URLError as e:  # can't connect at all
            last = e
        log(f"{server} unreachable ({last}), trying next server")
    raise last


def safe_name(name):
    """Refuse file names like '../../etc/passwd', since the server picks the names."""
    if not name or name != os.path.basename(name) or name.startswith("."):
        raise ValueError(f"bad file name from server: {name!r}")
    return name


def releases_from(payload):
    # Accept a bare list or {"releases": [...]} / {"updates": [...]}.
    if isinstance(payload, dict):
        payload = payload.get("releases") or payload.get("updates") or []
    return sorted(payload, key=lambda r: version_key(r["version"]))


def offered(rel, base):
    """Release settings the server delivers and the PC must honour itself.
    Returns None when this PC should take it, else why not."""
    settings = rel.get("settings") or {}
    min_from = settings.get("minFrom")
    if min_from and version_key(base) < version_key(min_from):
        return f"needs {min_from} or newer first (this PC: {base})"
    try:
        rollout = int(settings.get("rollout") or 0)  # % of PCs; 0 = everyone
    except (TypeError, ValueError):
        rollout = 0
    if 0 < rollout < 100:
        # Same PC + same version always lands in the same bucket (0-99), so a
        # PC doesn't flip in and out of a rollout between checks.
        digest = hashlib.sha256(f"{device_id()}:{rel['version']}".encode()).hexdigest()
        if int(digest[:8], 16) % 100 >= rollout:
            return f"not in this {rollout}% rollout yet"
    return None


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# ---------- check: download + verify ----------

def download(servers, name, dest):
    """Download with resume: a leftover .part file continues where it stopped."""
    part = dest + ".part"
    have = os.path.getsize(part) if os.path.exists(part) else 0
    headers = {"Range": f"bytes={have}-"} if have else {}
    path = "/api/os/files/" + urllib.parse.quote(name)
    try:
        resp = request(servers, path, headers=headers)
    except urllib.error.HTTPError as e:
        if e.code == 416:  # we already have every byte
            return part
        raise
    with resp:
        # 206 = server honoured the Range, append; 200 = full file, start over.
        mode = "ab" if resp.status == 206 else "wb"
        with open(part, mode) as f:
            shutil.copyfileobj(resp, f, 1 << 20)
    return part


def download_url(url, dest):
    """Download a direct URL (e.g. GitHub Release asset) with resume."""
    part = dest + ".part"
    have = os.path.getsize(part) if os.path.exists(part) else 0
    headers = {"User-Agent": "migood-os-update"}
    if have:
        headers["Range"] = f"bytes={have}-"
    req = urllib.request.Request(url, headers=headers)
    try:
        resp = urllib.request.urlopen(req, timeout=120)
    except urllib.error.HTTPError as e:
        if e.code == 416:
            return part
        raise
    with resp:
        mode = "ab" if resp.status == 206 else "wb"
        with open(part, mode) as f:
            shutil.copyfileobj(resp, f, 1 << 20)
    return part


def check_github(gh_url=None):
    """Check GitHub Releases directly. Always pulls the latest release/pre-release
    bundles newer than current_version(), verifying their .sha256 companion file."""
    gh_url = gh_url or github_releases_url(force=True)
    ver = current_version()
    log(f"checking GitHub Releases ({gh_url}) — note: this fetches the latest release/pre-release directly from GitHub")
    req = urllib.request.Request(gh_url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "migood-os-update",
    })
    with urllib.request.urlopen(req, timeout=60) as resp:
        payload = json.load(resp)
    if isinstance(payload, dict):
        payload = [payload]

    channel = read_kv(CONF).get("CHANNEL", "stable")
    candidates = []
    for gh_rel in payload:
        if not isinstance(gh_rel, dict) or gh_rel.get("draft"):
            continue
        r_ver = (gh_rel.get("tag_name") or "").strip().lstrip("v")
        if not r_ver or version_key(r_ver) <= version_key(ver):
            continue
        assets = {a.get("name"): a.get("browser_download_url")
                  for a in (gh_rel.get("assets") or [])
                  if isinstance(a, dict) and a.get("name") and a.get("browser_download_url")}
        bundle_name = f"migood-os-{r_ver}-update.tar.gz"
        if bundle_name not in assets:
            bundle_name = next((n for n in assets if n.endswith("-update.tar.gz")), None)
        if not bundle_name:
            continue
        sha_url = assets.get(bundle_name + ".sha256")
        if not sha_url:
            continue
        candidates.append({
            "version": r_ver,
            "prerelease": bool(gh_rel.get("prerelease")),
            "bundle_name": safe_name(bundle_name),
            "bundle_url": assets[bundle_name],
            "sha_url": sha_url,
        })

    # If channel is stable and non-prereleases exist, prefer them; otherwise GitHub
    # serves the latest release/pre-release regardless, as noted in GITHUB_NOTICE.
    if channel == "stable" and any(not c["prerelease"] for c in candidates):
        candidates = [c for c in candidates if not c["prerelease"]]

    candidates.sort(key=lambda c: version_key(c["version"]))
    if not candidates:
        log(f"up to date on GitHub Releases ({ver})")
        return 0

    base = ver
    for c in candidates:
        if version_key(c["version"]) <= version_key(base):
            continue
        r_ver = c["version"]
        name = c["bundle_name"]
        folder = os.path.join(STATE, "staged", r_ver)
        os.makedirs(folder, exist_ok=True)

        sha_req = urllib.request.Request(c["sha_url"], headers={"User-Agent": "migood-os-update"})
        with urllib.request.urlopen(sha_req, timeout=30) as sresp:
            expected_sha = sresp.read().decode("utf-8", errors="ignore").strip().split()[0].lower()
        if len(expected_sha) != 64:
            raise RuntimeError(f"{name}.sha256: invalid checksum from GitHub")

        dest = os.path.join(folder, name)
        if not (os.path.exists(dest) and sha256_of(dest) == expected_sha):
            log(f"downloading {r_ver}/{name} from GitHub Releases")
            part = download_url(c["bundle_url"], dest)
            got = sha256_of(part)
            if got != expected_sha:
                os.remove(part)
                raise RuntimeError(f"{name}: sha256 mismatch from GitHub (got {got})")
            os.replace(part, dest)

        kind_label = "Pre-release" if c["prerelease"] else "Release"
        rel_meta = {
            "version": r_ver,
            "channel": channel,
            "source": "github",
            "prerelease": c["prerelease"],
            "notes": f"Migood OS {r_ver} (GitHub {kind_label}). {GITHUB_NOTICE}",
            "files": [{"name": name, "sha256": expected_sha}],
            "settings": {},
        }
        with open(os.path.join(folder, "release.json"), "w") as out:
            json.dump(rel_meta, out)
        log(f"{r_ver} staged from GitHub Releases ({kind_label})")
        base = r_ver
    return 0


def cmd_check_github():
    return check_github(github_releases_url(force=True))


def cmd_check():
    gh_fallback = github_releases_url(force=False)
    try:
        servers, channel = config()
        ver = current_version()
        q = urllib.parse.urlencode({"from": ver, "channel": channel})
        with request(servers, f"/api/os/updates?{q}") as resp:
            releases = releases_from(json.load(resp))
    except BaseException as server_err:
        if gh_fallback:
            log(f"Migood server unavailable ({server_err}); falling back to GitHub Releases")
            try:
                return check_github(gh_fallback)
            except Exception as gh_err:
                log(f"GitHub fallback also failed: {gh_err}")
        raise

    if not releases:
        if gh_fallback:
            try:
                return check_github(gh_fallback)
            except Exception as gh_err:
                log(f"GitHub fallback check skipped: {gh_err}")
        log(f"up to date ({ver}, {channel})")
        return 0
    base = ver  # the version this PC will be on once everything staged so far is installed
    staged_any = False
    for rel in releases:
        if version_key(rel["version"]) <= version_key(base):
            continue
        why_not = offered(rel, base)
        if why_not:
            log(f"skipping {rel['version']}: {why_not}")
            continue
        folder = os.path.join(STATE, "staged", rel["version"])
        os.makedirs(folder, exist_ok=True)
        for f in rel.get("files", []):
            if isinstance(f, str):
                f = {"name": f}
            name = safe_name(f["name"])
            if name.endswith((".iso", ".squashfs")):
                continue  # ISOs (and the installer's spare system file) are for fresh installs
            dest = os.path.join(folder, name)
            if os.path.exists(dest) and sha256_of(dest) == f.get("sha256"):
                continue  # already downloaded and verified
            log(f"downloading {rel['version']}/{name}")
            part = download(servers, name, dest)
            got = sha256_of(part)
            if not f.get("sha256") or got != f["sha256"]:
                os.remove(part)  # never keep a file that fails the check
                raise RuntimeError(f"{name}: sha256 mismatch (got {got})")
            os.replace(part, dest)
        with open(os.path.join(folder, "release.json"), "w") as out:
            json.dump(rel, out)
        log(f"{rel['version']} staged, installs at next shutdown")
        base = rel["version"]
        staged_any = True
    if not staged_any and gh_fallback:
        try:
            check_github(gh_fallback)
        except Exception as gh_err:
            log(f"GitHub fallback check skipped: {gh_err}")
    return 0


# ---------- apply: install staged releases ----------

def snapshot(version):
    if NO_SNAPSHOT or not shutil.which("timeshift"):
        log("no Timeshift snapshot (timeshift missing or disabled)")
        return
    subprocess.run(["timeshift", "--create", "--scripted",
                    "--comments", f"before Migood OS {version}"], check=True)


def apply_bundle(path):
    with tempfile.TemporaryDirectory() as tmp:
        with tarfile.open(path) as tar:
            tar.extractall(tmp, filter="data")  # "data" blocks ../ and links out
        debs = sorted(
            os.path.join(tmp, "debs", d)
            for d in os.listdir(os.path.join(tmp, "debs"))
            if d.endswith(".deb")
        ) if os.path.isdir(os.path.join(tmp, "debs")) else []
        if debs:
            subprocess.run(["apt-get", "install", "-y", *debs], check=True,
                           env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
        script = os.path.join(tmp, "apply.sh")
        if os.path.exists(script):
            subprocess.run(["bash", script], cwd=tmp, check=True)


def staged_versions():
    root = os.path.join(STATE, "staged")
    if not os.path.isdir(root):
        return []
    return sorted((v for v in os.listdir(root)
                   if os.path.exists(os.path.join(root, v, "release.json"))),
                  key=version_key)


def cmd_apply():
    applied = False
    for ver in staged_versions():
        if version_key(ver) <= version_key(current_version()):
            shutil.rmtree(os.path.join(STATE, "staged", ver))
            continue
        folder = os.path.join(STATE, "staged", ver)
        with open(os.path.join(folder, "release.json")) as f:
            rel = json.load(f)
        log(f"installing {ver}")
        snapshot(ver)
        for f in rel.get("files", []):
            name = safe_name(f if isinstance(f, str) else f["name"])
            if name.endswith((".tar.gz", ".tgz")):
                apply_bundle(os.path.join(folder, name))
        # Only bump the version after everything worked; on failure the
        # exception stops here, so the release stays staged for next time.
        set_version(ver)
        shutil.rmtree(folder)
        applied = True
        log(f"now on {ver}")
    if applied:
        try:
            cmd_checkin()
        except Exception as e:  # offline at shutdown is fine
            log(f"checkin skipped: {e}")
    return 0


# ---------- checkin ----------

def cmd_checkin():
    servers, channel = config()
    body = {"device": device_id(), "version": current_version(), "channel": channel}
    with request(servers, "/api/os/checkin", data=body):
        pass
    log(f"checked in as {body['device']} ({body['version']}, {channel})")
    return 0


COMMANDS = {
    "check": cmd_check,
    "check-github": cmd_check_github,
    "apply": cmd_apply,
    "checkin": cmd_checkin,
}


def write_status(result, message=""):
    """Save what happened for the Migood Updates app (no secrets in here)."""
    staged = []
    for v in staged_versions():
        try:
            with open(os.path.join(STATE, "staged", v, "release.json")) as f:
                rel = json.load(f)
            item = {"version": v, "notes": rel.get("notes", ""),
                    "mandatory": bool((rel.get("settings") or {}).get("mandatory"))}
            if rel.get("source"):
                item["source"] = rel["source"]
            staged.append(item)
        except (OSError, ValueError):
            staged.append({"version": v, "notes": "", "mandatory": False})
    status = {
        "version": current_version(),
        "channel": read_kv(CONF).get("CHANNEL", "stable"),
        "checked_at": int(time.time()),
        "result": result,  # ok | error | not-signed-in | no-access
        "message": message,
        "staged": staged,
    }
    try:
        os.makedirs(os.path.dirname(STATUS), exist_ok=True)
        tmp = STATUS + ".new"
        with open(tmp, "w") as f:
            json.dump(status, f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATUS)
    except OSError as e:
        log(f"could not save status: {e}")


def main(argv):
    if len(argv) == 3 and argv[1] == "check" and argv[2] == "--github":
        argv = [argv[0], "check-github"]
    if len(argv) != 2 or argv[1] not in COMMANDS:
        print("usage: update check [--github]|check-github|apply|checkin", file=sys.stderr)
        return 2
    cmd = argv[1]
    try:
        code = COMMANDS[cmd]()
    except SystemExit as e:  # e.g. not signed in yet, or no server set
        if cmd != "checkin":
            write_status("not-signed-in" if "token" in str(e.code) else "error", str(e.code))
        raise
    except urllib.error.HTTPError as e:
        # 404 also means "this account isn't in the migood-os Beta".
        log(f"server said {e.code} for {e.url}")
        if cmd != "checkin":
            write_status("no-access" if e.code == 404 else "error", f"server said {e.code}")
        return 1
    except Exception as e:
        if cmd != "checkin":
            write_status("error", str(e))
        raise
    if cmd != "checkin":
        write_status("ok")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
