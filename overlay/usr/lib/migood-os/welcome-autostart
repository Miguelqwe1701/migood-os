#!/bin/sh
# Runs at every login (see /etc/xdg/autostart/migood-welcome.desktop) and
# picks the right screens. --tour quits right away once it has been seen.
if [ "$(id -un)" = migood-setup ]; then
  exec /usr/lib/migood-os/migood-setup --oobe     # first boot: sign in = make account
elif grep -qw 'boot=casper' /proc/cmdline; then
  exec /usr/lib/migood-os/migood-setup --live     # trying Migood OS from USB
else
  exec /usr/lib/migood-os/migood-setup --tour     # a new account's first login
fi
