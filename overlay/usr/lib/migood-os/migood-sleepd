            old_lives = 'callback(s ? (s.id.startsWith("screen:") && req.audioRequested ? { video: s, audio: "loopback" } : { video: s }) : {});'
            new_lives = 'callback(s ? (IS_WIN && s.id.startsWith("screen:") && req.audioRequested ? { video: s, audio: "loopback" } : { video: s }) : {});'
            if old_lives in pc_new:
                pc_new = pc_new.replace(old_lives, new_lives, 1)
            old_handler = (
