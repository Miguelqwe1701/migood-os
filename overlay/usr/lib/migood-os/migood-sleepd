#!/usr/bin/env python3
"""migood-sleepd: "Sleep & wake from anywhere" for Migood OS (runs as root).

The only part of the feature that needs root. The Migood Games app (signed in)
gets a wake ticket from the server (POST /api/remote/sleep) and hands it over
on the socket; from then on this service does the rest:

  sleep      set the RTC alarm for `every` minutes, suspend the PC
  check-in   the alarm wakes the PC: screen stays off, the person's apps are
             paused (frozen), Wi-Fi reconnects, and it asks the server
             POST /api/remote/wake/check {token}. Then, within 30 s of waking:
               wake:true        -> apps back, screen on, "Woken up from your phone"
               someone touched  -> apps back, screen on
               gone:true        -> stop sleeping (the ticket was forgotten)
               anything else    -> next alarm, back to sleep (apps stay paused)
  rescue     if this service stops or crashes mid check-in, apps are thawed and
             the screen turned on (ExecStopPost=... --rescue): a frozen desktop
             must never be what a person wakes up to.

Socket: /run/migood/sleepd.sock, one JSON object per line, one answer line each.
Only root and the Migood user of this PC may talk to it (checked with the
caller's real user id). Commands are only ever added, never changed:
  {"cmd":"status"}                         -> {"ok":true,"version":1,"sleeping":false,...}
  {"cmd":"sleep","token":"...","every":5}  -> {"ok":true}  (then the PC sleeps)
  {"cmd":"cancel"}                         -> {"ok":true}  (stop the sleep cycle)
  {"cmd":"resumed"}   root only, sent by the system-sleep hook after a resume

The ticket lives in /var/lib/migood-os/wake.json (root, 0600), never on a
command line or in the person's home.

  migood-sleepd            run the service
  migood-sleepd --dry-run  same, but "suspend" is a 10 s wait and no RTC alarm
                           is set: tests the whole check-in in a VM
  migood-sleepd --rescue   thaw the apps and turn the screen on, then exit
"""
import glob
import json
import os
import pwd
import re
import select
import socket
import struct
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import migoodlib  # noqa: E402

PROTOCOL = 1
STATE_DIR = os.environ.get("MIGOOD_STATE", "/var/lib/migood-os")
STATE = os.path.join(STATE_DIR, "wake.json")
SOCK = os.environ.get("MIGOOD_SLEEPD_SOCK", "/run/migood/sleepd.sock")
WINDOW = 30          # seconds from resume to decide (the owner's number)
NET_WAIT = 20        # seconds to wait for the network
RTC_SLACK = 60       # a resume this close to the alarm was caused by it
BATTERY_EVERY = 15   # minutes between check-ins on battery
LOW_BATTERY = 15     # percent: below this, stop checking in (stay asleep)
TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{16,128}$")


def log(msg):
    print(f"migood-sleepd: {msg}", flush=True)


# ---------- the system: everything that touches the PC lives here ----------

class System:
    """Real PC. Tests use a fake with the same methods."""
    dry_run = False

    def __init__(self, user=None):
        self.user = user  # login name of the Migood user (for freeze/screen/toast)

    def run(self, *cmd, timeout=15):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired) as e:
            log(f"{cmd[0]} failed: {e}")
            return None

    def now(self):
        return time.time()

    def sleep(self, seconds):
        time.sleep(seconds)

    # RTC alarm: the clock chip that wakes the PC up
    def set_alarm(self, when):
        try:
            with open("/sys/class/rtc/rtc0/wakealarm", "w") as f:
                f.write("0")
            with open("/sys/class/rtc/rtc0/wakealarm", "w") as f:
                f.write(str(int(when)))
        except OSError as e:
            log(f"RTC alarm not set: {e}")

    def clear_alarm(self):
        try:
            with open("/sys/class/rtc/rtc0/wakealarm", "w") as f:
                f.write("0")
        except OSError:
            pass

    def suspend(self):
        self.run("systemctl", "suspend")

    def _as_user(self, *cmd):
        """Run in the person's desktop session (screen, toast)."""
        if not self.user:
            return None
        try:
            uid = pwd.getpwnam(self.user).pw_uid
        except KeyError:
            return None
        return self.run("runuser", "-u", self.user, "--", "env",
                        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus", *cmd)

    def screen(self, on):
        # GNOME's own power-save switch: 0 = on, 3 = off. No flash, no lock.
        self._as_user("gdbus", "call", "--session", "--dest", "org.gnome.Mutter.DisplayConfig",
                      "--object-path", "/org/gnome/Mutter/DisplayConfig",
                      "--method", "org.freedesktop.DBus.Properties.Set",
                      "org.gnome.Mutter.DisplayConfig", "PowerSaveMode",
                      f"<int32 {0 if on else 3}>")

    def _slice(self, action):
        # The person's apps live in their systemd app.slice; the desktop itself
        # (session.slice) and system services keep running.
        if self.user:
            self.run("systemctl", "--user", "-M", f"{self.user}@", action, "app.slice")

    def freeze(self):
        self._slice("freeze")

    def thaw(self):
        self._slice("thaw")

    def network_up(self, timeout):
        """Wi-Fi on, wait until NetworkManager says the internet works."""
        self.run("nmcli", "radio", "wifi", "on")
        end = self.now() + timeout
        while self.now() < end:
            r = self.run("nmcli", "networking", "connectivity", "check", timeout=10)
            if r and r.stdout.strip() == "full":
                return True
            self.sleep(1)
        return False

    def wait_for_touch(self, timeout):
        """True if anyone uses a key, the touchpad, the mouse or the lid."""
        files = []
        for path in glob.glob("/dev/input/event*"):
            try:
                files.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
            except OSError:
                pass
        try:
            if not files:
                self.sleep(max(0, timeout))
                return False
            ready, _, _ = select.select(files, [], [], max(0, timeout))
            return bool(ready)
        finally:
            for fd in files:
                os.close(fd)

    def battery(self):
        """(on_battery, percent or None)."""
        on_ac, pct = None, None
        for d in glob.glob("/sys/class/power_supply/*"):
            try:
                kind = open(os.path.join(d, "type")).read().strip()
                if kind == "Mains":
                    on_ac = (on_ac or False) or open(os.path.join(d, "online")).read().strip() == "1"
                elif kind == "Battery" and pct is None:
                    pct = int(open(os.path.join(d, "capacity")).read().strip())
            except (OSError, ValueError):
                pass
        return (pct is not None and on_ac is False), pct

    def toast(self, text):
        self._as_user("notify-send", "--app-name=Migood OS", "-i", "migood-os", text)


class DryRunSystem(System):
    """Everything real except the sleep itself: no RTC alarm, and "suspend" is a
    10 s wait followed by a pretend alarm wake."""
    dry_run = True

    def set_alarm(self, when):
        log(f"(dry run) would wake at {time.strftime('%H:%M:%S', time.localtime(when))}")

    def clear_alarm(self):
        pass

    def suspend(self):
        log("(dry run) sleeping 10 s instead of suspending")

        def later():
            self.sleep(10)
            self.on_resume_hook()  # set by Sleepd: acts as if the alarm woke the PC
        threading.Thread(target=later, daemon=True).start()


# ---------- the service ----------

def migood_user():
    """The Migood account of this PC (setup writes account.json); on the live
    USB, the live user."""
    try:
        with open(os.path.join(STATE_DIR, "account.json")) as f:
            name = json.load(f)["local"]
        pwd.getpwnam(name)
        return name
    except (OSError, ValueError, KeyError):
        pass
    for p in pwd.getpwall():
        if p.pw_uid == 1000:
            return p.pw_name
    return None


class Sleepd:
    def __init__(self, system, server=None):
        self.sys = system
        self.server = server  # tests point this at a fake server
        self.lock = threading.Lock()
        self.state = self.load()
        system.on_resume_hook = lambda: self.on_resume(pretend_alarm=True)

    # --- state file ---
    def load(self):
        try:
            with open(STATE) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        fd = os.open(STATE + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(self.state, f)
        os.replace(STATE + ".new", STATE)

    # --- server ---
    def wake_check(self, up=False, battery=None, low=None):
        body = {"token": self.state["token"]}
        if up:
            body["up"] = True
        # Battery (PCs that have one) and "low" (the last check-in before the
        # cycle stops for low battery), so "Your devices" can show it.
        if battery is not None:
            body["battery"] = battery
        if low is not None:
            body["low"] = low
        if self.server:
            return migoodlib.api("/api/remote/wake/check", body, only=self.server, timeout=15)
        return migoodlib.api("/api/remote/wake/check", body, timeout=15)

    # --- socket commands ---
    def status(self):
        s = self.state
        on_batt, pct = self.sys.battery()
        return {"ok": True, "version": PROTOCOL, "sleeping": bool(s.get("sleeping")),
                "every": s.get("every"), "last": s.get("last"),
                "battery": pct, "on_battery": on_batt,
                "low_battery": bool(s.get("low_battery")), "dry_run": self.sys.dry_run}

    def cmd_sleep(self, token, every):
        if not isinstance(token, str) or not TOKEN_RE.match(token):
            return {"ok": False, "error": "bad token"}
        try:
            every = min(30, max(2, int(every or 5)))
        except (TypeError, ValueError):
            return {"ok": False, "error": "bad every"}
        with self.lock:
            self.state = {"token": token, "every": every, "sleeping": True,
                          "since": int(self.sys.now()), "last": self.state.get("last")}
            self.save()
        # Answer first, then sleep, so the app gets its reply.
        threading.Thread(target=self.go_to_sleep, args=(every, 2), daemon=True).start()
        return {"ok": True}

    def cmd_cancel(self):
        with self.lock:
            if self.state.get("token"):
                try:
                    self.wake_check(up=True)  # tell the server: awake, sleep over
                except RuntimeError as e:
                    log(f"cancel: server not told ({e})")
            self.sys.clear_alarm()
            self.state = {"last": self.state.get("last")}
            self.save()
        return {"ok": True}

    def handle(self, req, uid):
        cmd = req.get("cmd") if isinstance(req, dict) else None
        if cmd == "status":
            return self.status()
        if cmd == "sleep":
            return self.cmd_sleep(req.get("token"), req.get("every"))
        if cmd == "cancel":
            return self.cmd_cancel()
        if cmd == "resumed" and uid == 0:
            threading.Thread(target=self.on_resume, daemon=True).start()
            return {"ok": True}
        return {"ok": False, "error": f"unknown command: {cmd}"}

    # --- sleeping and waking ---
    def go_to_sleep(self, every, delay=0):
        if delay:
            self.sys.sleep(delay)
        on_batt, pct = self.sys.battery()
        with self.lock:
            if not self.state.get("sleeping"):
                return
            low = on_batt and pct is not None and pct < LOW_BATTERY
            self.state["low_battery"] = low
            if low:
                # Stay asleep: no more check-ins until it's plugged in or woken by hand.
                self.state.pop("alarm", None)
                self.sys.clear_alarm()
            else:
                minutes = max(every, BATTERY_EVERY) if on_batt else every
                self.state["alarm"] = int(self.sys.now() + minutes * 60)
                self.sys.set_alarm(self.state["alarm"])
            self.save()
            tell_low = low and not self.state.get("low_sent")
        if tell_low:
            # The cycle stops here; let the server show "Asleep - low battery".
            try:
                self.wake_check(battery=pct, low=True)
                with self.lock:
                    self.state["low_sent"] = True
                    self.save()
            except RuntimeError as e:
                log(f"low battery not reported ({e})")
        log("going to sleep" + (" (low battery, no check-ins)" if low else f", check-in in {minutes} min"))
        self.sys.suspend()

    def finish(self, result, tell_server=True):
        """A real wake: apps back, screen on, sleep cycle over."""
        self.sys.thaw()
        self.sys.screen(True)
        with self.lock:
            if tell_server and self.state.get("token"):
                try:
                    self.wake_check(up=True)
                except RuntimeError as e:
                    log(f"couldn't tell the server we're up ({e})")
            self.sys.clear_alarm()
            self.state = {"last": {"at": int(self.sys.now()), "result": result}}
            self.save()
        if result == "remote":
            self.sys.toast("Woken up from your phone")
        log(f"awake ({result})")

    def on_resume(self, pretend_alarm=False):
        with self.lock:
            st = dict(self.state)
        if not st.get("sleeping"):
            return  # an ordinary sleep (lid, menu): not ours
        alarm = st.get("alarm")
        by_alarm = pretend_alarm or (alarm and abs(self.sys.now() - alarm) <= RTC_SLACK)
        if not by_alarm:
            return self.finish("touched")  # power button, lid, key: a person
        try:
            self.check_in(st)
        except Exception as e:  # never leave the PC frozen with the screen off
            log(f"check-in failed: {e}")
            self.finish("error")

    def check_in(self, st):
        start = self.sys.now()
        self.sys.screen(False)
        self.sys.freeze()
        every = st.get("every", 5)
        if not self.sys.network_up(NET_WAIT):
            self.note("no-network")
            return self.go_to_sleep(every)
        on_batt, pct = self.sys.battery()
        low = bool(on_batt and pct is not None and pct < LOW_BATTERY)
        try:
            r = self.wake_check(battery=pct, low=low)
        except RuntimeError as e:
            log(f"check-in: {e}")
            self.note("no-server")
            return self.go_to_sleep(every)
        with self.lock:
            self.state["low_sent"] = low
        if r.get("gone"):
            return self.finish("gone", tell_server=False)
        if r.get("wake"):
            return self.finish("remote")
        try:
            every = min(30, max(2, int(r.get("every") or every)))
        except (TypeError, ValueError):
            pass
        with self.lock:
            self.state["every"] = every
        if self.sys.wait_for_touch(WINDOW - (self.sys.now() - start)):
            return self.finish("touched")
        self.note("asleep")
        self.go_to_sleep(every)

    def note(self, result):
        with self.lock:
            self.state["last"] = {"at": int(self.sys.now()), "result": result}
            self.save()

    def rescue(self):
        self.sys.thaw()
        self.sys.screen(True)


# ---------- socket server ----------

def peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


def serve(daemon):
    os.makedirs(os.path.dirname(SOCK), exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    srv.listen(8)
    owner = None
    log(f"listening on {SOCK}" + (" (dry run)" if daemon.sys.dry_run else ""))
    while True:
        # The Migood user can change (setup makes it); keep the socket theirs.
        user = migood_user()
        daemon.sys.user = user
        if user != owner:
            if os.geteuid() == 0:  # always, except in the tests
                os.chown(SOCK, pwd.getpwnam(user).pw_uid if user else 0, -1)
            owner = user
        ready, _, _ = select.select([srv], [], [], 60)
        if not ready:
            continue
        conn, _ = srv.accept()
        threading.Thread(target=client, args=(daemon, conn, owner), daemon=True).start()


def client(daemon, conn, owner):
    with conn:
        uid = peer_uid(conn)
        allowed = {0, os.geteuid()} | ({pwd.getpwnam(owner).pw_uid} if owner else set())
        f = conn.makefile("rwb")
        if uid not in allowed:
            f.write(b'{"ok":false,"error":"not allowed"}\n')
            f.flush()
            return
        for line in f:
            if len(line) > 4096:
                break
            try:
                req = json.loads(line)
            except ValueError:
                req = None
            ans = daemon.handle(req, uid) if req is not None else {"ok": False, "error": "bad json"}
            f.write(json.dumps(ans).encode() + b"\n")
            f.flush()


def main(argv):
    if os.geteuid() != 0:
        sys.exit("migood-sleepd must run as root")
    system = DryRunSystem() if "--dry-run" in argv else System()
    system.user = migood_user()
    daemon = Sleepd(system)
    if "--rescue" in argv:
        daemon.rescue()
        return
    # A previous run may have stopped mid check-in.
    daemon.rescue()
    serve(daemon)


if __name__ == "__main__":
    main(sys.argv[1:])
