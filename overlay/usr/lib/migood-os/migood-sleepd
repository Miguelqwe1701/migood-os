    1. Send the Bearer token from localStorage / ~/.config/migood/token for sleep & wake.
    2. Allow silent screen sharing on Migood OS without spamming Share Screen prompts.
    3. Give Remote Play full input control via xdotool + migood-sleepd /dev/uinput."""
    asar_path = asar_path or ASAR_PATH
    if not os.path.exists(asar_path):
        return False
    try:
        with open(asar_path, "rb") as f:
            raw = f.read()
        if len(raw) < 16:
            return False
        _, u1, _, u3 = struct.unpack("<IIII", raw[:16])
        base = 8 + u1
        hdr = json.loads(raw[16:16 + u3].decode("utf-8"))
        files = hdr.get("files") or {}
        if "wake.js" not in files or "wake_migoodos.js" not in files:
            return False

        def read_entry(name):
            info = files.get(name)
            if not info or "offset" not in info or "size" not in info:
                return None, None
            off, sz = int(info["offset"]), int(info["size"])
            return info, raw[base + off:base + off + sz].decode("utf-8").replace("\r\n", "\n")

        w_info, w_src = read_entry("wake.js")
        wm_info, wm_src = read_entry("wake_migoodos.js")
        m_info, m_src = read_entry("main.js")
        pc_info, pc_src = read_entry("pchost.js")
        pi_info, pi_src = read_entry("pcinput_linux.js")
        if w_src is None or wm_src is None:
            return False

        modified = {}

        old_get_ticket = (
            'async function getTicket(every, name, kind) {\n'
            '  const win = pageWindows().find((w) => w && !w.isDestroyed() && (w.webContents.getURL() || "").startsWith(SITE));\n'
