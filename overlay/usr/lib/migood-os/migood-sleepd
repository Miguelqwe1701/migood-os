class UInputDriver:
    """Kernel-level virtual mouse, keyboard, and absolute pointer via /dev/uinput.
    Works across both Wayland and X11 without needing display server permissions."""
    UI_SET_EVBIT = 0x40045564
    UI_SET_KEYBIT = 0x40045565
    UI_SET_RELBIT = 0x40045566
    UI_SET_ABSBIT = 0x40045567
    UI_SET_PROPBIT = 0x4004556E
    UI_DEV_CREATE = 0x5501

    def __init__(self):
        self.lock = threading.Lock()
        self.rel_fd = None
        self.abs_fd = None

    def _ensure_open(self):
        if self.rel_fd is not None and self.abs_fd is not None:
            return True
        try:
            import fcntl
            subprocess.run(["modprobe", "uinput"], capture_output=True, timeout=3)
            if self.rel_fd is None:
                fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
                fcntl.ioctl(fd, self.UI_SET_EVBIT, 0x00)  # EV_SYN
                fcntl.ioctl(fd, self.UI_SET_EVBIT, 0x01)  # EV_KEY
                fcntl.ioctl(fd, self.UI_SET_EVBIT, 0x02)  # EV_REL
                for kc in set(UINPUT_KEYMAP.values()) | {0x110, 0x111, 0x112}:
                    fcntl.ioctl(fd, self.UI_SET_KEYBIT, kc)
                for rc in (0x00, 0x01, 0x06, 0x08):  # REL_X, REL_Y, REL_HWHEEL, REL_WHEEL
                    fcntl.ioctl(fd, self.UI_SET_RELBIT, rc)
                udev = struct.pack("<80sHHHHI256i", b"Migood Remote Play Input", 0x03, 0x1234, 0x5678, 1, 0, *([0] * 256))
                os.write(fd, udev)
                fcntl.ioctl(fd, self.UI_DEV_CREATE)
                self.rel_fd = fd
            if self.abs_fd is None:
                fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
                fcntl.ioctl(fd, self.UI_SET_EVBIT, 0x00)  # EV_SYN
                fcntl.ioctl(fd, self.UI_SET_EVBIT, 0x01)  # EV_KEY
                fcntl.ioctl(fd, self.UI_SET_EVBIT, 0x03)  # EV_ABS
                fcntl.ioctl(fd, self.UI_SET_PROPBIT, 0x01)  # INPUT_PROP_DIRECT
                for kc in (0x110, 0x111, 0x112):
                    fcntl.ioctl(fd, self.UI_SET_KEYBIT, kc)
                fcntl.ioctl(fd, self.UI_SET_ABSBIT, 0x00)  # ABS_X
                fcntl.ioctl(fd, self.UI_SET_ABSBIT, 0x01)  # ABS_Y
                abs_arrays = [0] * 256
                abs_arrays[0] = 32767  # absmax[ABS_X]
                abs_arrays[1] = 32767  # absmax[ABS_Y]
                udev = struct.pack("<80sHHHHI256i", b"Migood Remote Play Pointer", 0x03, 0x1234, 0x5679, 1, 0, *abs_arrays)
                os.write(fd, udev)
                fcntl.ioctl(fd, self.UI_DEV_CREATE)
                self.abs_fd = fd
            return True
        except Exception as e:
            log(f"uinput init failed: {e}")
            return False

    def _emit(self, fd, ev_type, code, val):
        os.write(fd, struct.pack("<llHHi", 0, 0, ev_type, code, int(val)))

    def execute(self, args, width=1920, height=1080):
        with self.lock:
            if not self._ensure_open():
                return False
            try:
                w = max(1, int(width or 1920))
                h = max(1, int(height or 1080))
                i = 0
                n = len(args)
                btns = {"1": 0x110, "2": 0x112, "3": 0x111}
                while i < n:
                    cmd = args[i]
                    if cmd == "mousemove" and i + 2 < n:
                        x = max(0, min(32767, int(float(args[i + 1]) * 32767 / w)))
                        y = max(0, min(32767, int(float(args[i + 2]) * 32767 / h)))
                        self._emit(self.abs_fd, 0x03, 0x00, x)
                        self._emit(self.abs_fd, 0x03, 0x01, y)
                        self._emit(self.abs_fd, 0x00, 0x00, 0)
                        i += 3
                    elif cmd == "mousemove_relative" and i + 3 < n and args[i + 1] == "--":
                        dx = int(float(args[i + 2]))
                        dy = int(float(args[i + 3]))
                        self._emit(self.rel_fd, 0x02, 0x00, dx)
                        self._emit(self.rel_fd, 0x02, 0x01, dy)
                        self._emit(self.rel_fd, 0x00, 0x00, 0)
                        i += 4
                    elif cmd in ("mousedown", "mouseup") and i + 1 < n:
                        b = btns.get(args[i + 1])
                        if b:
                            self._emit(self.rel_fd, 0x01, b, 1 if cmd == "mousedown" else 0)
                            self._emit(self.rel_fd, 0x00, 0x00, 0)
                        i += 2
                    elif cmd == "click" and i + 3 < n and args[i + 1] == "--repeat":
                        times = max(1, min(20, int(float(args[i + 2]))))
                        btn = args[i + 3]
                        val = 1 if btn == "4" else (-1 if btn == "5" else 0)
                        if val:
                            for _ in range(times):
                                self._emit(self.rel_fd, 0x02, 0x08, val)
                                self._emit(self.rel_fd, 0x00, 0x00, 0)
                        i += 4
                    elif cmd == "click" and i + 1 < n:
                        btn = args[i + 1]
                        if btn in ("6", "7"):
                            self._emit(self.rel_fd, 0x02, 0x06, 1 if btn == "7" else -1)
                            self._emit(self.rel_fd, 0x00, 0x00, 0)
                        elif btn in btns:
                            b = btns[btn]
                            self._emit(self.rel_fd, 0x01, b, 1)
                            self._emit(self.rel_fd, 0x00, 0x00, 0)
                            self._emit(self.rel_fd, 0x01, b, 0)
                            self._emit(self.rel_fd, 0x00, 0x00, 0)
                        i += 2
                    elif cmd in ("keydown", "keyup") and i + 1 < n:
                        kc = UINPUT_KEYMAP.get(args[i + 1])
                        if kc:
                            self._emit(self.rel_fd, 0x01, kc, 1 if cmd == "keydown" else 0)
                            self._emit(self.rel_fd, 0x00, 0x00, 0)
                        i += 2
                    else:
                        i += 1
                return True
            except Exception as e:
                log(f"uinput write failed: {e}")
                return False


UINPUT = UInputDriver()


# ---------- the service ----------

def migood_user():
    """The Migood account of this PC (setup writes account.json); on the live
    USB, the live user."""
    try:
        with open(os.path.join(STATE_DIR, "account.json")) as f:
            name = json.load(f)["local"]
        pwd.getpwnam(name)
        return name
    except (OSError, ValueError, KeyError):
        pass
    for p in pwd.getpwall():
        if p.pw_uid == 1000:
            return p.pw_name
    return None


def get_login_token(user=None):
    """Retrieve the Migood login token, the same way migood-ai,
    migood-settings, and update do. Checks user's ~/.config/migood/token,
    /var/lib/migood-os/token, and as a fallback Migood Games' Local Storage."""
    candidates = []
    homes = []
    if user:
        try:
            home = pwd.getpwnam(user).pw_dir
            homes.append(home)
            candidates.append(os.path.join(home, ".config/migood/token"))
        except (KeyError, OSError):
            pass
    candidates.append(os.path.expanduser("~/.config/migood/token"))
    candidates.append(os.path.join(STATE_DIR, "token"))

    for p in candidates:
        try:
            with open(p) as f:
                val = f.read().strip()
                if val:
                    return val
        except OSError:
            pass

    for home in homes:
        patterns = [
            os.path.join(home, ".config", "*igood*", "Local Storage", "leveldb", "*"),
            os.path.join(home, ".config", "chromium", "*", "Local Storage", "leveldb", "*"),
        ]
        ldb_files = []
        for pat in patterns:
            ldb_files.extend(p for p in glob.glob(pat) if p.endswith((".log", ".ldb")))
        ldb_files.sort(key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
        for p in ldb_files:
            try:
                with open(p, "rb") as f:
                    matches = LEVELDB_TOKEN_RE.findall(f.read())
                if matches:
                    return matches[-1].decode("ascii", errors="ignore").strip()
            except OSError:
                pass
    return None


def _asar_integrity(data):
    block_size = 4 * 1024 * 1024
    blocks = [
        hashlib.sha256(data[i:i + block_size]).hexdigest()
        for i in range(0, max(1, len(data)), block_size)
    ]
    return {
        "algorithm": "SHA256",
        "hash": hashlib.sha256(data).hexdigest(),
        "blockSize": block_size,
        "blocks": blocks,
    }


def _collect_asar_leaves(node, out):
    for val in (node.get("files") or {}).values():
        if isinstance(val, dict):
            if "files" in val:
                _collect_asar_leaves(val, out)
            elif "offset" in val and "size" in val:
                out.append(val)


def patch_migood_games_app(asar_path=None):
