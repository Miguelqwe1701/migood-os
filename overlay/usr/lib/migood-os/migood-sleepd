def log(msg):
    print(f"migood-sleepd: {msg}", flush=True)


# ---------- the system: everything that touches the PC lives here ----------

# Heavy 3rd-party game processes that can be paused during sleep without
# freezing migood-games or the desktop/network stack.
GAME_PROCS = ("steam", "wine", "wine64", "wineserver", "retroarch", "dolphin-emu", "PPSSPPQt", "ppsspp")


class System:
    """Real PC. Tests use a fake with the same methods."""
    dry_run = False
    connected_sleep = os.environ.get("MIGOOD_HARDWARE_SUSPEND") != "1"

    def __init__(self, user=None):
        self.user = user  # login name of the Migood user (for freeze/screen/toast)
        self._sleep_gen = 0
        self._inhibit_proc = None
        self.on_resume_hook = lambda: None
        self.on_touch_wake_hook = lambda: None

    def run(self, *cmd, timeout=15):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired) as e:
            log(f"{cmd[0]} failed: {e}")
            return None

    def now(self):
        return time.time()

    def sleep(self, seconds):
        time.sleep(seconds)

    # RTC alarm: the clock chip that wakes the PC up
    def set_alarm(self, when):
        try:
            with open("/sys/class/rtc/rtc0/wakealarm", "w") as f:
                f.write("0")
            with open("/sys/class/rtc/rtc0/wakealarm", "w") as f:
                f.write(str(int(when)))
        except OSError as e:
            log(f"RTC alarm not set: {e}")

    def clear_alarm(self):
        self._sleep_gen += 1
        self._stop_inhibit()
        try:
            with open("/sys/class/rtc/rtc0/wakealarm", "w") as f:
                f.write("0")
        except OSError:
            pass

    def _start_inhibit(self):
        if self._inhibit_proc and self._inhibit_proc.poll() is None:
            return
        try:
            self._inhibit_proc = subprocess.Popen([
                "systemd-inhibit",
                "--what=sleep:idle:handle-lid-switch",
                "--who=Migood Sleep",
                "--why=Keep internet connected for Migood Remote Play wake",
                "sleep", "infinity",
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self._inhibit_proc = None

    def _stop_inhibit(self):
        proc = self._inhibit_proc
        self._inhibit_proc = None
        if proc and proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass

    def keep_network_alive(self):
        """Ensure NetworkManager and Wi-Fi stay connected and never power down during sleep."""
        self.run("nmcli", "networking", "on")
        self.run("nmcli", "radio", "wifi", "on")
        for path in glob.glob("/sys/class/net/wl*"):
            iface = os.path.basename(path)
            self.run("iw", "dev", iface, "set", "power_save", "off", timeout=5)

    def suspend(self):
        if not self.connected_sleep:
            self._stop_inhibit()
            self.run("systemctl", "suspend")
            return
        # Connected Low-Power Sleep: turn off screen, enable power-saver, inhibit
        # hardware S3 suspend (which kills Wi-Fi/Ethernet), keep network alive,
        # and watch for touch input or check-in intervals while online.
        self._start_inhibit()
        self.keep_network_alive()
        self.screen(False)
        self.freeze()
        self.run("powerprofilesctl", "set", "power-saver", timeout=5)
        self._sleep_gen += 1
        gen = self._sleep_gen

        def connected_loop():
            # Wait up to 15s in 2s slices so physical touch wakes the PC in < 2s
            # and remote wake from Migood Games is checked every ~15s with internet live.
            for _ in range(7):
                if gen != self._sleep_gen:
                    return
                if self.wait_for_touch(2):
                    if gen == self._sleep_gen:
                        self.on_touch_wake_hook()
                    return
            if gen == self._sleep_gen:
                self.on_resume_hook()

        threading.Thread(target=connected_loop, daemon=True).start()

    def _as_user(self, *cmd):
        """Run in the person's desktop session (screen, toast)."""
        if not self.user:
            return None
        try:
            uid = pwd.getpwnam(self.user).pw_uid
        except KeyError:
            return None
        return self.run("runuser", "-u", self.user, "--", "env",
                        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus", *cmd)

    def unlock_session(self):
        """Ensure the desktop session is unlocked and never blocks Remote Play."""
        self.run("loginctl", "unlock-sessions", timeout=5)
        self._as_user("gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver",
                      "--object-path", "/org/gnome/ScreenSaver",
                      "--method", "org.gnome.ScreenSaver.SetActive", "false")

    def desktop_env(self):
        """Discover DISPLAY, XAUTHORITY, and XDG_SESSION_TYPE from the active desktop session."""
        env = {"DISPLAY": ":0"}
        uid = None
        home = ""
        if self.user:
            try:
                pw = pwd.getpwnam(self.user)
                uid = pw.pw_uid
                home = pw.pw_dir
            except KeyError:
                pass
        for path in glob.glob("/proc/[0-9]*/comm"):
            try:
                with open(path) as f:
                    comm = f.read().strip()
                if comm not in ("gnome-shell", "Xorg", "Xwayland"):
                    continue
                pdir = os.path.dirname(path)
                if uid is not None and os.stat(pdir).st_uid != uid:
                    continue
                with open(os.path.join(pdir, "environ"), "rb") as ef:
                    raw_env = ef.read().split(b"\x00")
                for item in raw_env:
                    if b"=" in item:
                        k, v = item.decode("utf-8", errors="ignore").split("=", 1)
                        if k in ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "XDG_SESSION_TYPE", "DBUS_SESSION_BUS_ADDRESS") and v:
                            env[k] = v
                if "DISPLAY" in env and "XAUTHORITY" in env:
                    break
            except OSError:
                continue
        if not os.path.exists("/tmp/.X11-unix/X" + env.get("DISPLAY", ":0").lstrip(":")):
            for d in ("0", "1"):
                if os.path.exists(f"/tmp/.X11-unix/X{d}"):
                    env["DISPLAY"] = f":{d}"
                    break
        if "XAUTHORITY" not in env or not os.path.exists(env.get("XAUTHORITY", "")):
            cands = []
            if uid is not None:
                cands.append(f"/run/user/{uid}/gdm/Xauthority")
                cands.extend(glob.glob(f"/run/user/{uid}/.mutter-Xwaylandauth.*"))
            if home:
                cands.append(os.path.join(home, ".Xauthority"))
            for c in cands:
                if os.path.exists(c):
                    env["XAUTHORITY"] = c
                    break
        return env

    def ensure_permissions(self):
        """Grant full OS, input (/dev/uinput, /dev/input/*), X11, and screen-lock
        permissions so Remote Play can always control the PC."""
        self.run("modprobe", "uinput", timeout=5)
        try:
            if os.path.exists("/dev/uinput"):
                os.chmod("/dev/uinput", 0o666)
            for p in glob.glob("/dev/input/event*"):
                os.chmod(p, 0o666)
        except OSError:
            pass
        if self.user:
            self.run("usermod", "-aG", "input,video,render,plugdev,audio,adm,sudo,lpadmin", self.user, timeout=5)
            self._as_user("gsettings", "set", "org.gnome.desktop.screensaver", "lock-enabled", "false")
            self._as_user("gsettings", "set", "org.gnome.desktop.screensaver", "idle-activation-enabled", "false")
            self._as_user("gsettings", "set", "org.gnome.desktop.screensaver", "ubuntu-lock-on-suspend", "false")
            self._as_user("gsettings", "set", "org.gnome.desktop.lockdown", "disable-lock-screen", "true")
            self._as_user("gsettings", "set", "org.gnome.desktop.session", "idle-delay", "uint32 0")
            env = self.desktop_env()
            cmd_env = [f"{k}={v}" for k, v in env.items()]
            self.run("runuser", "-u", self.user, "--", "env", *cmd_env, "xhost", "+local:", timeout=5)
        self.unlock_session()

    def inject_input(self, args, width=1920, height=1080):
        """Execute Remote Play mouse/keyboard commands via X11 xdotool and/or kernel /dev/uinput."""
        if not args or not isinstance(args, list):
            return False
        clean_args = [str(a) for a in args[:500]]
        env = self.desktop_env()
        is_wayland = env.get("XDG_SESSION_TYPE") == "wayland" or bool(env.get("WAYLAND_DISPLAY") and not os.path.exists("/usr/bin/xdotool"))
        if not is_wayland and os.path.exists("/usr/bin/xdotool") and self.user:
            cmd_env = [f"{k}={v}" for k, v in env.items()]
            r = self.run("runuser", "-u", self.user, "--", "env", *cmd_env, "xdotool", *clean_args, timeout=3)
            if r is not None and r.returncode == 0:
                return True
        return UINPUT.execute(clean_args, width=width, height=height)

    def screen(self, on):
        # GNOME's own power-save switch: 0 = on, 3 = off. No flash, no lock.
        if on:
            self.unlock_session()
        self._as_user("gdbus", "call", "--session", "--dest", "org.gnome.Mutter.DisplayConfig",
                      "--object-path", "/org/gnome/Mutter/DisplayConfig",
                      "--method", "org.freedesktop.DBus.Properties.Set",
                      "org.gnome.Mutter.DisplayConfig", "PowerSaveMode",
                      f"<int32 {0 if on else 3}>")
        if on:
            self.run("powerprofilesctl", "set", "balanced", timeout=5)

    def freeze(self):
        # Pause heavy 3rd-party game binaries if running, but NEVER freeze app.slice
        # because migood-games lives in app.slice and needs its network sockets open!
        for proc in GAME_PROCS:
            self.run("pkill", "-STOP", "-x", proc, timeout=5)

    def thaw(self):
        self._stop_inhibit()
        for proc in GAME_PROCS:
            self.run("pkill", "-CONT", "-x", proc, timeout=5)
        if self.user:
            self.run("systemctl", "--user", "-M", f"{self.user}@", "thaw", "app.slice", timeout=5)

    def network_up(self, timeout):
        """Keep Wi-Fi and NetworkManager on and verify internet/server reachability."""
        self.keep_network_alive()
        end = self.now() + max(1, timeout)
        while self.now() < end:
            # 1. Direct check against Migood servers (most accurate)
            try:
                if any(migoodlib.test_server(s, timeout=4) for s in migoodlib.servers()):
                    return True
            except Exception:
                pass
            # 2. Check active default route in kernel routing table
            rt = self.run("ip", "route", "show", "default", timeout=5)
            if rt and rt.stdout.strip():
                return True
            # 3. Check NetworkManager connectivity / general state
            r = self.run("nmcli", "-t", "-f", "STATE,CONNECTIVITY", "general", timeout=5)
            if r and ("connected:full" in r.stdout or "connected:limited" in r.stdout or "connected:unknown" in r.stdout):
                return True
            self.sleep(1)
        return False

    def wait_for_touch(self, timeout):
        """True if anyone uses a key, the touchpad, the mouse or the lid."""
        files = []
        for path in glob.glob("/dev/input/event*"):
            try:
                files.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK))
            except OSError:
                pass
        try:
            if not files:
                self.sleep(max(0, timeout))
                return False
            ready, _, _ = select.select(files, [], [], max(0, timeout))
            return bool(ready)
        finally:
            for fd in files:
                os.close(fd)

    def battery(self):
        """(on_battery, percent or None)."""
        on_ac, pct = None, None
        for d in glob.glob("/sys/class/power_supply/*"):
            try:
                kind = open(os.path.join(d, "type")).read().strip()
                if kind == "Mains":
                    on_ac = (on_ac or False) or open(os.path.join(d, "online")).read().strip() == "1"
                elif kind == "Battery" and pct is None:
                    pct = int(open(os.path.join(d, "capacity")).read().strip())
            except (OSError, ValueError):
                pass
        return (pct is not None and on_ac is False), pct

    def toast(self, text):
        self._as_user("notify-send", "--app-name=Migood OS", "-i", "migood-os", text)


class DryRunSystem(System):
    """Everything real except the sleep itself: no RTC alarm, and "suspend" is a
    10 s wait followed by a pretend alarm wake."""
    dry_run = True
    connected_sleep = False

    def set_alarm(self, when):
        log(f"(dry run) would wake at {time.strftime('%H:%M:%S', time.localtime(when))}")

    def clear_alarm(self):
        pass

    def suspend(self):
        log("(dry run) sleeping 10 s instead of suspending")

        def later():
            self.sleep(10)
            self.on_resume_hook()  # set by Sleepd: acts as if the alarm woke the PC
        threading.Thread(target=later, daemon=True).start()


