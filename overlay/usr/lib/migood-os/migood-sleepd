            )
            if old_flush in pi_new:
                pi_new = pi_new.replace(old_flush, new_flush, 1)
            if pi_new != pi_src:
                modified[id(pi_info)] = pi_new.encode("utf-8")

        if not modified:
            return False

        leaves = []
        _collect_asar_leaves(hdr, leaves)
        leaves.sort(key=lambda info: int(info["offset"]))

        first_idx = next(i for i, info in enumerate(leaves) if id(info) in modified)
        min_off = int(leaves[first_idx]["offset"])
        prefix = raw[base:base + min_off]
        tail_chunks = []
        cur_off = min_off
        for info in leaves[first_idx:]:
            old_off, old_sz = int(info["offset"]), int(info["size"])
            data = modified.get(id(info))
            if data is None:
                data = raw[base + old_off:base + old_off + old_sz]
            info["offset"] = str(cur_off)
            info["size"] = len(data)
            info["integrity"] = _asar_integrity(data)
            tail_chunks.append(data)
            cur_off += len(data)

        hdr_bytes = json.dumps(hdr, separators=(",", ":")).encode("utf-8")
        pad = (4 - (len(hdr_bytes) % 4)) % 4
        padded_hdr = hdr_bytes + (b"\x00" * pad)
        new_hdr = struct.pack("<IIII", 4, len(padded_hdr) + 8, len(padded_hdr) + 4, len(hdr_bytes)) + padded_hdr

        tmp = asar_path + ".new"
        with open(tmp, "wb") as f:
            f.write(new_hdr)
            f.write(prefix)
            for chunk in tail_chunks:
                f.write(chunk)
        os.chmod(tmp, 0o644)
        os.replace(tmp, asar_path)
        log(f"patched {asar_path} for Remote Play sleep auth, silent screen capture & full input control")
        return True
    except Exception as e:
        log(f"could not patch {asar_path}: {e}")
        return False


class Sleepd:
    def __init__(self, system, server=None):
        self.sys = system
        self.server = server  # tests point this at a fake server
        self.lock = threading.Lock()
        self.state = self.load()
        system.on_resume_hook = lambda: self.on_resume(pretend_alarm=True)
        system.on_touch_wake_hook = lambda: self.finish("touched")

    def get_token(self):
        return get_login_token(self.sys.user if self.sys else None)

    def rp_device_id(self):
        path = os.path.join(STATE_DIR, "rp-device-id")
        try:
            with open(path) as f:
                val = f.read().strip()
                if val:
                    return val
        except OSError:
            pass
        dev = "dev-" + uuid.uuid4().hex[:10]
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(path, "w") as f:
                f.write(dev + "\n")
        except OSError:
            pass
        return dev

    # --- state file ---
    def load(self):
        try:
            with open(STATE) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save(self):
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = STATE + ".new"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(self.state, f)
            os.replace(tmp, STATE)
        except OSError as e:
            log(f"save state: {e}")

    def _register_sleep_ticket(self, login_tok, every, dev_id=None, name=None):
        body = {
            "id": (dev_id.strip() if isinstance(dev_id, str) and dev_id.strip() else None) or self.rp_device_id(),
            "name": ((name.strip() if isinstance(name, str) and name.strip() else None) or socket.gethostname())[:40],
            "every": every,
            "kind": "os",
        }
        if self.server:
            return migoodlib.api("/api/remote/sleep", body, token=login_tok, only=self.server, timeout=10)
        return migoodlib.api("/api/remote/sleep", body, token=login_tok, timeout=10)

    # --- server ---
    def wake_check(self, up=False, battery=None, low=None):
        pending_tok = self.state.get("pending_login_token")
        if pending_tok:
            try:
                res = self._register_sleep_ticket(
                    pending_tok,
                    self.state.get("every", 5),
                    dev_id=self.state.get("dev_id"),
                    name=self.state.get("name"),
                )
                if isinstance(res, dict) and res.get("token"):
                    with self.lock:
                        self.state["token"] = res["token"]
                        self.state.pop("pending_login_token", None)
                        self.save()
            except Exception as e:
                log(f"deferred sleep ticket registration failed: {e}")
        tok = self.state.get("token") or self.get_token()
        body = {"token": tok}
        if up:
            body["up"] = True
        # Battery (PCs that have one) and "low" (the last check-in before the
        # cycle stops for low battery), so "Your devices" can show it.
        if battery is not None:
            body["battery"] = battery
        if low is not None:
            body["low"] = low
        if self.server:
            return migoodlib.api("/api/remote/wake/check", body, only=self.server, timeout=15)
        return migoodlib.api("/api/remote/wake/check", body, timeout=15)

    # --- socket commands ---
    def status(self):
        s = self.state
        on_batt, pct = self.sys.battery()
        tok = self.get_token()
        return {"ok": True, "version": PROTOCOL, "sleeping": bool(s.get("sleeping")),
                "every": s.get("every"), "last": s.get("last"),
                "battery": pct, "on_battery": on_batt,
                "low_battery": bool(s.get("low_battery")), "dry_run": self.sys.dry_run,
                "logged_in": bool(tok), "user": self.sys.user}

    def cmd_set_token(self, token):
        if not token or not isinstance(token, str):
            return {"ok": False, "error": "bad token"}
        token = token.strip()
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            t_path = os.path.join(STATE_DIR, "token")
            with open(t_path, "w") as f:
                f.write(token + "\n")
            os.chmod(t_path, 0o600)
            if self.sys.user:
                try:
                    pw = pwd.getpwnam(self.sys.user)
                    u_dir = os.path.join(pw.pw_dir, ".config/migood")
                    os.makedirs(u_dir, exist_ok=True)
                    u_path = os.path.join(u_dir, "token")
                    with open(u_path, "w") as f:
                        f.write(token + "\n")
                    os.chmod(u_path, 0o600)
                    os.chown(u_path, pw.pw_uid, pw.pw_gid)
                    os.chown(u_dir, pw.pw_uid, pw.pw_gid)
                except (KeyError, OSError):
                    pass
            return {"ok": True, "logged_in": True}
        except OSError as e:
            return {"ok": False, "error": str(e)}

    def cmd_sleep(self, token, every, auth_token=None, dev_id=None, name=None):
        if auth_token and isinstance(auth_token, str) and auth_token.strip():
            self.cmd_set_token(auth_token.strip())
        if not token:
            token = (auth_token.strip() if isinstance(auth_token, str) and auth_token.strip() else None) or self.get_token()
        if not token:
            return {"ok": False, "error": "You must be logged in."}
        try:
            every = min(30, max(2, int(every or 5)))
        except (TypeError, ValueError):
            return {"ok": False, "error": "bad every"}

        wake_ticket = token
        pending_login_token = None
        # If token is not already a 48-char wake ticket, obtain one via POST /api/remote/sleep
        if not (isinstance(token, str) and len(token) == 48 and TOKEN_RE.match(token)):
            login_tok = (auth_token.strip() if isinstance(auth_token, str) and auth_token.strip() else None) or self.get_token() or token
            try:
                if hasattr(self.sys, "keep_network_alive"):
                    self.sys.keep_network_alive()
                res = self._register_sleep_ticket(login_tok, every, dev_id=dev_id, name=name)
                if isinstance(res, dict) and res.get("token"):
                    wake_ticket = res["token"]
                    if isinstance(res.get("every"), int) and 2 <= res["every"] <= 30:
                        every = res["every"]
            except Exception as e:
                log(f"register sleep note: {e}")
                if isinstance(login_tok, str) and len(login_tok) >= 16 and " " not in login_tok:
                    pending_login_token = login_tok
                    if not TOKEN_RE.match(wake_ticket):
                        wake_ticket = "pending_" + uuid.uuid4().hex
                elif not (isinstance(wake_ticket, str) and TOKEN_RE.match(wake_ticket)):
                    return {"ok": False, "error": str(e)}

        if not isinstance(wake_ticket, str) or not TOKEN_RE.match(wake_ticket):
            return {"ok": False, "error": "bad token"}
        with self.lock:
            self.state = {"token": wake_ticket, "every": every, "sleeping": True,
                          "since": int(self.sys.now()), "last": self.state.get("last")}
            if pending_login_token:
                self.state["pending_login_token"] = pending_login_token
                self.state["dev_id"] = dev_id
                self.state["name"] = name
            self.save()
        # Answer first, then sleep, so the app gets its reply.
        threading.Thread(target=self.go_to_sleep, args=(every, 2), daemon=True).start()
        return {"ok": True}

    def cmd_cancel(self):
        with self.lock:
            if self.state.get("token"):
                try:
                    self.wake_check(up=True)  # tell the server: awake, sleep over
                except RuntimeError as e:
                    log(f"cancel: server not told ({e})")
            self.sys.clear_alarm()
            self.state = {"last": self.state.get("last")}
            self.save()
        return {"ok": True}

    def handle(self, req, uid):
        cmd = req.get("cmd") if isinstance(req, dict) else None
        if cmd == "status":
            return self.status()
        if cmd in ("token", "get-token", "login-status"):
            tok = self.get_token()
            return {"ok": True, "logged_in": bool(tok), "token": tok}
        if cmd in ("login", "set-token"):
            return self.cmd_set_token(req.get("token"))
        if cmd == "sleep":
            return self.cmd_sleep(req.get("token"), req.get("every"),
                                  auth_token=req.get("auth_token"),
                                  dev_id=req.get("id"),
                                  name=req.get("name"))
        if cmd == "cancel":
            return self.cmd_cancel()
        if cmd in ("input", "xdotool"):
            ok = self.sys.inject_input(req.get("args") or [], req.get("w") or 1920, req.get("h") or 1080) if hasattr(self.sys, "inject_input") else False
            return {"ok": bool(ok)}
        if cmd == "unlock":
            if hasattr(self.sys, "unlock_session"):
                self.sys.unlock_session()
            return {"ok": True}
        if cmd == "resumed" and uid == 0:
            threading.Thread(target=self.on_resume, daemon=True).start()
            return {"ok": True}
        return {"ok": False, "error": f"unknown command: {cmd}"}

    # --- sleeping and waking ---
    def go_to_sleep(self, every, delay=0):
        if delay:
            self.sys.sleep(delay)
        on_batt, pct = self.sys.battery()
        with self.lock:
            if not self.state.get("sleeping"):
                return
            low = on_batt and pct is not None and pct < LOW_BATTERY
            self.state["low_battery"] = low
            if low:
                # Stay asleep: no more check-ins until it's plugged in or woken by hand.
                self.state.pop("alarm", None)
                self.sys.clear_alarm()
            else:
                minutes = max(every, BATTERY_EVERY) if on_batt else every
                self.state["alarm"] = int(self.sys.now() + minutes * 60)
                self.sys.set_alarm(self.state["alarm"])
            self.save()
            tell_low = low and not self.state.get("low_sent")
        if tell_low:
            # The cycle stops here; let the server show "Asleep - low battery".
            try:
                self.wake_check(battery=pct, low=True)
                with self.lock:
                    self.state["low_sent"] = True
                    self.save()
            except RuntimeError as e:
                log(f"low battery not reported ({e})")
        log("going to sleep" + (" (low battery, no check-ins)" if low else f", check-in in {minutes} min"))
        self.sys.suspend()

    def finish(self, result, tell_server=True):
        """A real wake: apps back, screen on, sleep cycle over."""
        self.sys.thaw()
        self.sys.screen(True)
        with self.lock:
            if tell_server and self.state.get("token"):
                try:
                    self.wake_check(up=True)
                except RuntimeError as e:
                    log(f"couldn't tell the server we're up ({e})")
            self.sys.clear_alarm()
            self.state = {"last": {"at": int(self.sys.now()), "result": result}}
            self.save()
        if result == "remote":
            self.sys.toast("Woken up from your phone")
        log(f"awake ({result})")

    def on_resume(self, pretend_alarm=False):
        with self.lock:
            st = dict(self.state)
        if not st.get("sleeping"):
            return  # an ordinary sleep (lid, menu): not ours
        alarm = st.get("alarm")
        by_alarm = pretend_alarm or (alarm and abs(self.sys.now() - alarm) <= RTC_SLACK)
        if not by_alarm:
            return self.finish("touched")  # power button, lid, key: a person
        try:
            self.check_in(st)
        except Exception as e:  # never leave the PC frozen with the screen off
            log(f"check-in failed: {e}")
            self.finish("error")

    def check_in(self, st):
        start = self.sys.now()
        self.sys.screen(False)
        self.sys.freeze()
        every = st.get("every", 5)
        if not self.sys.network_up(NET_WAIT):
            self.note("no-network")
            return self.go_to_sleep(every)
        on_batt, pct = self.sys.battery()
        low = bool(on_batt and pct is not None and pct < LOW_BATTERY)
        try:
            r = self.wake_check(battery=pct, low=low)
        except RuntimeError as e:
            log(f"check-in: {e}")
            self.note("no-server")
            return self.go_to_sleep(every)
        with self.lock:
            self.state["low_sent"] = low
        if r.get("gone"):
            return self.finish("gone", tell_server=False)
        if r.get("wake"):
            return self.finish("remote")
        try:
            every = min(30, max(2, int(r.get("every") or every)))
        except (TypeError, ValueError):
            pass
        with self.lock:
            self.state["every"] = every
        touch_wait = 1 if getattr(self.sys, "connected_sleep", False) else (WINDOW - (self.sys.now() - start))
        if self.sys.wait_for_touch(touch_wait):
            return self.finish("touched")
        self.note("asleep")
        self.go_to_sleep(every)

    def note(self, result):
        with self.lock:
            self.state["last"] = {"at": int(self.sys.now()), "result": result}
            self.save()

    def rescue(self):
        self.sys.thaw()
        self.sys.screen(True)


# ---------- socket server ----------

def peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


def serve(daemon):
    os.makedirs(os.path.dirname(SOCK), exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    srv.listen(8)
    owner = None
    log(f"listening on {SOCK}" + (" (dry run)" if daemon.sys.dry_run else ""))
    while True:
        # The Migood user can change (setup makes it); keep the socket theirs.
        user = migood_user()
        daemon.sys.user = user
        if user != owner:
            if os.geteuid() == 0:  # always, except in the tests
                os.chown(SOCK, pwd.getpwnam(user).pw_uid if user else 0, -1)
            owner = user
        ready, _, _ = select.select([srv], [], [], 60)
        if not ready:
            continue
        conn, _ = srv.accept()
        threading.Thread(target=client, args=(daemon, conn, owner), daemon=True).start()


def client(daemon, conn, owner):
    with conn:
        uid = peer_uid(conn)
        allowed = {0, os.geteuid()} | ({pwd.getpwnam(owner).pw_uid} if owner else set())
        f = conn.makefile("rwb")
        if uid not in allowed:
            f.write(b'{"ok":false,"error":"not allowed"}\n')
            f.flush()
            return
        for line in f:
            if len(line) > 32768:
                break
            try:
                req = json.loads(line)
            except ValueError:
                req = None
            ans = daemon.handle(req, uid) if req is not None else {"ok": False, "error": "bad json"}
            f.write(json.dumps(ans).encode() + b"\n")
            f.flush()


def main(argv):
    if "--patch-app" in argv:
        patch_migood_games_app()
        return
    if os.geteuid() != 0:
        sys.exit("migood-sleepd must run as root")
    patch_migood_games_app()
    system = DryRunSystem() if "--dry-run" in argv else System()
    system.user = migood_user()
    daemon = Sleepd(system)
    if "--rescue" in argv:
        daemon.rescue()
        return
    # A previous run may have stopped mid check-in.
    daemon.rescue()
    system.ensure_permissions()
    serve(daemon)


if __name__ == "__main__":
    main(sys.argv[1:])
