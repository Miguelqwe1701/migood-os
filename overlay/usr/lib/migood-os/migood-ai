#!/usr/bin/env python3
"""Migood AI on the desktop: a small chat window with Markdown support (feature 25).

  migood-ai ["question"]   opens the window, asking the question right away

Uses the same Migood AI as the site (/api/ai/chat), with the same rules:
water limits, age filters for 12-and-under, all decided by the server.
Conversations from here are private (not saved to your Migood AI history).
Supports formatted Markdown (bold, lists, headings, links, and code blocks with copy).
"""
import os
import sys
import threading

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from migoodlib import api  # noqa: E402
from migoodmd import blocks  # noqa: E402

TOKEN_USER = os.path.expanduser("~/.config/migood/token")
TOKEN_SYS = "/var/lib/migood-os/token"

CSS = b"""
@define-color accent_bg_color #2ecc71;
@define-color accent_color #2ecc71;
@define-color accent_fg_color #0a0d12;

window, .background {
    font-family: Nunito, system-ui, sans-serif;
    background-color: #0e1217;
}

.chat-scroll {
    background: transparent;
}

