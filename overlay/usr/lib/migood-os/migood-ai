"""


def token():
    for p in (TOKEN_USER, TOKEN_SYS):
        try:
            with open(p) as f:
                val = f.read().strip()
                if val:
                    return val
        except OSError:
            pass
    return None


class Chat(Adw.ApplicationWindow):
    def __init__(self, app, first):
        super().__init__(application=app, title="Migood AI", default_width=560, default_height=680)
        self.conversation = []
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.water = Gtk.Label(css_classes=["water-badge"])
        header.pack_end(self.water)
        view.add_top_bar(header)

        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                            margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
        self.scroll = Gtk.ScrolledWindow(child=self.list, vexpand=True, css_classes=["chat-scroll"])

        self.entry = Gtk.Entry(placeholder_text="Ask Migood AI…", hexpand=True, css_classes=["chat-entry"])
        self.entry.connect("activate", lambda *_: self.send())
        self.send_btn = Gtk.Button(icon_name="go-up-symbolic", css_classes=["suggested-action", "circular"])
        self.send_btn.connect("clicked", lambda *_: self.send())

        input_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, css_classes=["input-container"])
        input_box.append(self.entry)
        input_box.append(self.send_btn)

        bottom = Gtk.Box(spacing=8, margin_top=6, margin_bottom=14, margin_start=14, margin_end=14)
        bottom.append(input_box)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.scroll)
        box.append(bottom)
        view.set_content(box)
        self.set_content(view)

        if not token():
            self.bubble("ai", "Sign in with Migood Games to use Migood AI here. "
                              "(Setup signs you in, or sign in from the Migood Games app.)")
            self.entry.set_sensitive(False)
            self.send_btn.set_sensitive(False)
        elif first:
            self.entry.set_text(first)
            GLib.idle_add(self.send)

    def scroll_to_bottom(self):
        GLib.idle_add(lambda: self.scroll.get_vadjustment().set_value(
            self.scroll.get_vadjustment().get_upper()))

    def make_code_card(self, code_text, lang):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, css_classes=["code-box"])
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        badge = Gtk.Label(label=(lang or "code").lower(), css_classes=["code-label"],
                          halign=Gtk.Align.START, hexpand=True)
        copy_btn = Gtk.Button(label="Copy", css_classes=["copy-btn", "flat"])

        def on_copy(*_):
            clipboard = Gdk.Display.get_default().get_clipboard()
            clipboard.set(code_text)
            copy_btn.set_label("✓ Copied")
            GLib.timeout_add(2000, lambda: (copy_btn.set_label("Copy"), False)[1])

        copy_btn.connect("clicked", on_copy)
        top.append(badge)
        top.append(copy_btn)
        card.append(top)

        code_lbl = Gtk.Label(label=code_text, wrap=True, selectable=True, xalign=0, css_classes=["code-text"])
        card.append(code_lbl)
        return card

    def populate_bubble(self, box, who, text):
        if who == "me":
            lbl = Gtk.Label(label=text, wrap=True, selectable=True, xalign=0)
            lbl.set_max_width_chars(52)
            box.append(lbl)
            return

        rendered = blocks(text)
        if not rendered:
            lbl = Gtk.Label(label=text or "No answer.", wrap=True, selectable=True, xalign=0)
            lbl.set_max_width_chars(52)
            box.append(lbl)
            return

        for block in rendered:
            kind = block[0]
            if kind == "text":
                lbl = Gtk.Label(wrap=True, selectable=True, xalign=0, css_classes=["md-text"])
                lbl.set_use_markup(True)
                lbl.set_max_width_chars(52)
                try:
                    lbl.set_markup(block[1])
                except Exception:
                    lbl.set_text(block[1])
                lbl.connect("activate-link", lambda _lbl, uri: (Gtk.show_uri(self, uri, Gdk.CURRENT_TIME), True)[1])
                box.append(lbl)
            elif kind == "code":
                code_text = block[1]
                lang = block[2] if len(block) > 2 else ""
                box.append(self.make_code_card(code_text, lang))

    def bubble(self, who, text, thinking=False):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                      halign=Gtk.Align.END if who == "me" else Gtk.Align.START)
        sender = Gtk.Label(label="You" if who == "me" else "✨ Migood AI",
                           halign=Gtk.Align.END if who == "me" else Gtk.Align.START,
                           css_classes=["sender-me" if who == "me" else "sender-ai"])
        row.append(sender)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      css_classes=["bubble", "me" if who == "me" else "ai"])
        row.append(box)

        if thinking:
            lbl = Gtk.Label(label="Thinking…", css_classes=["note"], xalign=0)
            box.append(lbl)
            self.list.append(row)
            self.scroll_to_bottom()
            return box

        self.populate_bubble(box, who, text)
        self.list.append(row)
        self.scroll_to_bottom()
        return box

    def update_bubble(self, box, text):
        child = box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt
        self.populate_bubble(box, "ai", text)
        self.scroll_to_bottom()

    def send(self):
        text = self.entry.get_text().strip()
        if not text:
            return False
        self.entry.set_text("")
        self.entry.set_sensitive(False)
        self.send_btn.set_sensitive(False)

        self.bubble("me", text)
        self.conversation.append({"role": "user", "content": text})
        thinking_box = self.bubble("ai", "", thinking=True)

        def run():
            try:
                res = api("/api/ai/chat", {"mode": "normal", "messages": self.conversation,
                                           "private": True}, token=token(), timeout=90)
                reply = res.get("reply") or res.get("error") or "No answer."
                water = (res.get("water"), res.get("waterMax"))
            except RuntimeError as e:
                reply, water = str(e), (None, None)

            def show():
                self.update_bubble(thinking_box, reply)
                self.conversation.append({"role": "assistant", "content": reply})
                if isinstance(water[0], (int, float)) and water[1]:
                    self.water.set_label(f"💧 {water[0]}/{water[1]}")
                self.entry.set_sensitive(True)
                self.send_btn.set_sensitive(True)
                self.entry.grab_focus()

            GLib.idle_add(show)

        threading.Thread(target=run, daemon=True).start()
        return False


class App(Adw.Application):
    def __init__(self, first):
        super().__init__(application_id="os.migood.AI")
        self.first = first

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        Chat(self, self.first).present()


if __name__ == "__main__":
    first = " ".join(sys.argv[1:]).strip()
    sys.exit(App(first).run([sys.argv[0]]))
