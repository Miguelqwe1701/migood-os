    font-family: 'JetBrains Mono', monospace, Courier;
    font-size: 12.5px;
    color: #e6edf3;
}

.copy-btn {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 6px;
}

.md-text {
    font-size: 14px;
    line-height: 1.45;
}

